---
import { Image } from 'astro:assets';
import Base from '../layouts/Base.astro';
import Icon from '../components/Icon.astro';
import { Content as About } from '../content/about.md';
import headshot from '../assets/images/headshot.jpg';
import { site } from '../site.config';

// Split the name into letters so they can rise in one after another.
let n = 0;
const words = site.name.split(' ').map((w) => [...w].map((ch) => ({ ch, i: n++ })));
---

<Base>
  <section class="hero" data-ink-hero>
    <div class="glow" aria-hidden="true"></div>
    <h1 class="name" aria-label={site.name}>
      {
        words.map((letters) => (
          <span class="word" aria-hidden="true">
            {letters.map(({ ch, i }) => (
              <span class="char" style={`--i:${i}`}>
                {ch}
              </span>
            ))}
          </span>
        ))
      }
    </h1>
    <div class="lines">
      {site.heroLines.map((line) => <p>{line}</p>)}
    </div>
    <div class="ctas">
      {site.sections.map((s) => <a href={`/${s.id}`} class="label-link">{s.cta}</a>)}
    </div>
    <a href="#about" class="scroll-cue" aria-label="Scroll to About">
      <Icon name="arrow-down" />
    </a>
  </section>

  <section id="about" class="about">
    <div class="about-inner">
      <div class="headshot" data-reveal>
        <Image src={headshot} alt={`Headshot of ${site.name}`} widths={[300, 500, 800]} sizes="(max-width: 768px) 250px, 400px" />
      </div>
      <div class="text">
        <h2 data-reveal>About Me</h2>
        <div class="bio" data-reveal style="--reveal-delay:120ms">
          <About />
        </div>
      </div>
    </div>
    <div class="ctas" data-reveal>
      {site.sections.map((s) => <a href={`/${s.id}`} class="label-link">{s.cta}</a>)}
    </div>
  </section>
</Base>

<style>
  /* ---------- Hero ---------- */
  .hero {
    position: relative;
    isolation: isolate;
    overflow: hidden;
    min-height: 100dvh;
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
    text-align: center;
    padding: calc(var(--header-h) + 2rem) var(--gutter) 6rem;
    background: var(--ink);
    color: var(--paper);
  }

  /* Two soft lights drifting slowly behind the name. */
  .glow {
    position: absolute;
    inset: -20%;
    z-index: -1;
    background:
      radial-gradient(40% 35% at 30% 40%, color-mix(in srgb, var(--accent) 22%, transparent), transparent 70%),
      radial-gradient(35% 30% at 72% 62%, color-mix(in srgb, var(--paper) 9%, transparent), transparent 70%);
    filter: blur(20px);
    animation: drift 18s var(--ease-in-out) infinite alternate;
  }
  @keyframes drift {
    to {
      translate: 6% -5%;
      rotate: 8deg;
    }
  }

  .name {
    font-size: clamp(3.25rem, 11vw, 6.5rem);
    line-height: 1;
    margin-bottom: 1.75rem;
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    column-gap: 0.28em;
  }
  .word {
    display: inline-flex;
  }
  .char {
    display: inline-block;
    animation: letter 1.1s var(--ease-out) both;
    animation-delay: calc(0.15s + var(--i) * 45ms);
  }
  @keyframes letter {
    from {
      opacity: 0;
      translate: 0 0.45em;
      filter: blur(8px);
    }
  }

  .lines p {
    margin: 0;
    font-size: clamp(1.05rem, 2.2vw, 1.3rem);
    line-height: 1.6;
  }
  .lines,
  .hero .ctas,
  .scroll-cue {
    animation: fade-up 1s var(--ease-out) both;
  }
  .lines { animation-delay: 0.75s; }
  .hero .ctas { animation-delay: 0.95s; }
  .scroll-cue { animation-delay: 1.2s; }
  @keyframes fade-up {
    from {
      opacity: 0;
      translate: 0 1rem;
    }
  }

  .ctas {
    display: flex;
    flex-wrap: wrap;
    justify-content: center;
    gap: 1.25rem 4rem;
    margin-top: 3rem;
  }
  .hero .label-link {
    --link-hover: var(--accent-on-ink);
  }

  .scroll-cue {
    margin-top: 3rem;
    font-size: 2rem;
    display: inline-flex;
    transition: color 0.3s ease;
  }
  .scroll-cue :global(svg) {
    animation: bob 2.4s var(--ease-in-out) infinite;
  }
  .scroll-cue:hover {
    color: var(--accent-on-ink);
  }
  @keyframes bob {
    50% {
      translate: 0 6px;
    }
  }

  /* ---------- About ---------- */
  /* At least a screen tall, like the original, so the arrow can always scroll the hero fully
     away — on a short page the hero would linger under the header on tall screens. */
  .about {
    min-height: 100dvh;
    padding: clamp(5rem, 10vw, 8rem) var(--gutter) clamp(4rem, 8vw, 6rem);
    display: flex;
    flex-direction: column;
    justify-content: center;
    align-items: center;
  }
  .about-inner {
    display: flex;
    align-items: center;
    gap: clamp(2.5rem, 6vw, 5rem);
    max-width: 78rem;
  }
  .headshot {
    flex: 0 0 auto;
    width: min(25rem, 32vw);
    aspect-ratio: 1;
    border-radius: 50%;
    overflow: hidden;
    background: var(--line);
    box-shadow: 0 20px 50px -20px rgb(0 0 0 / 0.3);
  }
  .headshot :global(img) {
    width: 100%;
    height: 100%;
    object-fit: cover;
  }
  /* Where supported, the photo eases from a slight zoom to rest as it scrolls through view. */
  @supports (animation-timeline: view()) {
    @media (prefers-reduced-motion: no-preference) {
      .headshot :global(img) {
        animation: settle linear both;
        animation-timeline: view();
        animation-range: entry 0% cover 50%;
      }
      @keyframes settle {
        from {
          scale: 1.18;
        }
      }
    }
  }
  .text {
    max-width: 50rem;
  }
  .text h2 {
    font-size: clamp(2.25rem, 4vw, 2.75rem);
    margin-bottom: 1.25rem;
  }
  .bio :global(p) {
    margin: 0 0 1.1rem;
    font-size: 1.05rem;
    line-height: 1.8;
    text-wrap: pretty;
  }
  .about .ctas {
    margin-top: 2.5rem;
  }

  @media (max-width: 768px) {
    .about-inner {
      flex-direction: column;
    }
    .headshot {
      width: min(15.5rem, 70vw);
    }
  }
</style>
