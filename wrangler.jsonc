// Served by Cloudflare Workers as a static site: `npm run build` writes dist/, and every
// request is answered from it (unknown paths get dist/404.html with a 404 status).
{
  "$schema": "node_modules/wrangler/config-schema.json",
  "name": "jackjansons-dev",
  "compatibility_date": "2026-10-05",
  "assets": {
    "directory": "./dist",
    "not_found_handling": "404-page",
  },
  // Required by `wrangler preview`, which Workers Builds runs for non-production branches.
  // Empty is fine: the assets and compatibility settings above apply to previews too.
  "previews": {},
}
